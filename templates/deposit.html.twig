{% extends 'layouts/step-property.html.twig' %}

{% block title %}{{data.name}}{% endblock %}

{% block main %}
    
    <h1>{{ 'property.deposit.h1'|trans }}</h1>

    <zb-input
        name="{{ field_name(form.deposit) }}" 
        value="{{ field_value(form.deposit) }}"
        type="number"
        unit="{{ country.currency.symbol }}"
        placeholder='{{ "property.deposit.placeholder"|trans }}'
        required
    ></zb-input>

{% endblock %}